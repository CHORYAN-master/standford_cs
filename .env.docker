# Docker 환경 변수
# docker-compose.yml에서 사용됨

# 포트 설정
STREAMLIT_PORT=8501

# 경로 설정
BASE_DIR=/data
PROJECT_DIR=/app

# 로깅
LOG_LEVEL=INFO
LOG_FILE=/app/logs/mcp_server.log

# 보안 설정
MAX_FILE_SIZE_MB=10
MAX_CONTENT_SIZE_MB=5
RATE_LIMIT_CALLS_PER_MINUTE=100

# 타임아웃
GIT_OPERATION_TIMEOUT=10
COMMAND_EXECUTION_TIMEOUT=30
